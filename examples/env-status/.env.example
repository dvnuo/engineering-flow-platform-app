# Copy this file to .env and fill it in. `efp-app dev` reads .env; never commit it.
#
# The token is on the app's page in the Portal (register the app first).
EFP_APP_TOKEN=
# The address of the EFP Portal as you open it in the browser.
EFP_PORTAL_URL=
# Optional: who you are while developing. Default: the owner of the app.
# Use "anonymous" to see the app as a visitor who is not signed in.
# EFP_DEV_VISITOR=alice
